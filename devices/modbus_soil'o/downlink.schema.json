{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Device Downlink Schema",
  "description": "Schema for validating downlink commands to the device (TS013 compliant)",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "description": "Command parameters for the downlink message",
      "properties": {
        "sendHexFrame": {
          "type": "string",
          "description": "Send a custom hex frame, optionally with port specification (format: hexstring or hexstring:port)",
          "pattern": "^([0-9a-fA-F]+)(:[0-9]{1,3})?$"
        },
        "sendConfirmedMode": { "type": "integer", "enum": [0, 1] },
        "sendReboot": { "type": "boolean", "enum": [true] },
        "sendFactoryReset": { "type": "boolean", "enum": [true] },
        "sendLoraRetries": { "type": "integer", "minimum": 1, "maximum": 7 },
        "sendLoraRejoin": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
